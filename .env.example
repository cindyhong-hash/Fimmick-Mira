# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev)
DATABASE_URL="file:./prisma/dev.db"

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Anthropic Claude — 用於文案生成、語氣轉換
# 取得：https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI — 備用（目前圖片生成改用 OpenRouter）
# 取得：https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# OpenRouter — 用於圖片生成（google/gemini-3-pro-image-preview）
# 取得：https://openrouter.ai/keys → Create Key
OPENROUTER_API_KEY="sk-or-v1-..."

# ── 圖片儲存（上線時替換）────────────────────────────────────────────────────
# 目前圖片存在 /public/uploads（本機）
# 上線時建議改用 Cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── 資料庫（上線時替換）──────────────────────────────────────────────────────
# 目前使用 SQLite，上線時建議改用 PostgreSQL
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
