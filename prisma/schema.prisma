generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id             String     @id @default(cuid())
  name           String
  primaryColor   String
  secondaryColor String?
  logoUrl        String?
  toneLabels         String     @default("[]")
  commonText         String     @default("")
  pastPostImageUrls  String     @default("[]")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  activities     Activity[]
}

model Activity {
  id                   String            @id @default(cuid())
  clientId             String
  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  theme                String
  focusPoint           String
  titleText            String?           // 畫面上必放的主標題文字
  subtitleText         String?           // 畫面上必放的副標題文字
  imagePrompt          String?           // 使用者描述的腦中畫面 prompt
  productImageUrl      String            @default("")   // backward compat (first image)
  productImageUrls     String            @default("[]") // 最多 5 張（JSON array）
  referenceImageUrls   String            @default("[]")
  selectedComponentIds String            @default("[]") // 選取的風格組件 IDs
  imageRatio           String            @default("1:1") // 圖片比例
  imageModel           String            @default("google/gemini-3-pro-image-preview") // 生圖模型
  layoutId             String            @default("single")  // 多圖版型 id（single = 單圖）
  genMode              String            @default("unified") // 多圖生成模式：unified（統一主題）| perCell（各圖獨立）
  cells                String            @default("[]")      // 各格資料 JSON: [{description, mustText, assetUrls[]}]
  logoMode             String            @default("first")   // LOGO 位置：first | all | none
  variantCount         Int               @default(1)         // 多圖統一主題：生成幾組（1 或 2＝A導購+B敘事）
  status               String            @default("PENDING")
  errorMessage         String?           // 生成失敗時的真正錯誤原因（顯示在 UI，免翻 log）
  createdAt            DateTime          @default(now())
  generatedLayouts     GeneratedLayout[]
}

model GeneratedLayout {
  id              String   @id @default(cuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  layoutType      String
  imageUrl        String
  copyText        String
  styleComponents String   @default("{}")
  isSelected      Boolean  @default(false)
  textBurnedIn    Boolean  @default(false)  // 文字是否已由 AI 燒入圖片
  savedToLibrary  Boolean  @default(false)  // 是否已加入素材庫（策展）
  cellImageUrls   String   @default("[]")   // 多圖拼版：各格子圖 URL（供日後個別編輯）
  createdAt       DateTime @default(now())
}

model StyleComponent {
  id             String   @id @default(cuid())
  name           String
  type           String
  data           String   @default("{}")
  sourceLayoutId String
  clientId       String?
  aiPromptText   String   @default("")
  previewUrl     String?
  createdAt      DateTime @default(now())
}
